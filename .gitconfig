[user]
  name = Tim Wingfield
  email = tim@timwingfield.com
[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[merge]
  tool = vimdiff
  conflictstyle = zdiff3
[mergetool]
  keepBackup = false
[core]
  autocrlf = input
  editor = vim
  excludesfile = ~/.gitignore_global
[branch]
  autosetuprebase = always
[alias]
  ci = commit
  co = checkout
  st = status
  br = branch
  ch = cherry -v origin
  mine = log --author=Tim
  hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
  type = cat-file -t
  dump = cat-file -p
  # Mark a repo as trusted
  trust = "!mkdir -p .git/safe"
[github]
  user = timwingfield
[credential]
  helper = osxkeychain
[push]
  default = current
  autoSetupRemote = true
[fetch]
  prune = true
[rerere]
  enabled = true
[init]
  defaultBranch = trunk
